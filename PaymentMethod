import java.util.*;

interface PaymentMethod {
    double calculateAmount(double amount);
    String getType();
}

class Card implements PaymentMethod {
    public double calculateAmount(double amount) {
        return amount * 1.02;
    }

    public String getType() {
        return "CARD";
    }
}

class Wallet implements PaymentMethod {
    public double calculateAmount(double amount) {
        return amount * 1.01;
    }

    public String getType() {
        return "WALLET";
    }
}

class BankTransfer implements PaymentMethod {
    public double calculateAmount(double amount) {
        return amount;
    }

    public String getType() {
        return "BANKTRANSFER";
    }
}

public class PaymentSystem {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Map<String, PaymentMethod> methods = new HashMap<>();
        methods.put("CARD", new Card());
        methods.put("WALLET", new Wallet());
        methods.put("BANKTRANSFER", new BankTransfer());

        int n = sc.nextInt();
        double total = 0;

        for (int i = 0; i < n; i++) {
            String type = sc.next();
            double amount = sc.nextDouble();

            PaymentMethod payment = methods.get(type);
            double adjustedAmount = payment.calculateAmount(amount);

            System.out.printf("%s: %.2f%n", type, adjustedAmount);
            total += adjustedAmount;
        }

        System.out.printf("Total: %.2f%n", total);

        sc.close();
    }
}
